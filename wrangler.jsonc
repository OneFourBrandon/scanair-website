{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scanair-website",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-21",
  "observability": {
    "enabled": true
  },
  "vars": {
    "CONTACT_TO_EMAIL": "contact@scanair.ca",
    "CONTACT_FROM_EMAIL": "contact@scanair.ca",
    "CONTACT_FROM_NAME": "ScanAir"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
